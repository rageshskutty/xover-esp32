{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xover-esp32 chain-v1 parametric filter-stack configuration",
  "description": "Closed device configuration. JSON stores parametric filter intent; firmware calculates normalized biquad coefficients in double precision at complete configuration load and executes prepared sections. Per-output abstract protection is mandatory. Driver T/S, driver curves, amplifier/PSU model data, volts, and watts are designer-side only.",
  "type": "object",
  "required": [
    "v",
    "fs_hz",
    "inputs",
    "outputs"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "fs_hz": {
      "const": 48000,
      "description": "The sole v1 sample rate; all SOS sections and firmware execute at this rate."
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "L",
          "R",
          "C",
          "LFE",
          "SL",
          "SR"
        ]
      }
    },
    "pre": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/preChain"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/output"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "preChain": {
      "type": "object",
      "required": [
        "channel",
        "filters"
      ],
      "properties": {
        "channel": {
          "enum": [
            "L",
            "R",
            "C",
            "LFE",
            "SL",
            "SR"
          ]
        },
        "filters": {
          "$ref": "#/$defs/filterArray"
        }
      },
      "additionalProperties": false
    },
    "inputMix": {
      "type": "object",
      "required": [
        "channel",
        "weight"
      ],
      "properties": {
        "channel": {
          "enum": [
            "L",
            "R",
            "C",
            "LFE",
            "SL",
            "SR"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": -4,
          "maximum": 4,
          "not": {
            "const": 0
          }
        }
      },
      "additionalProperties": false
    },
    "outputChain": {
      "type": "object",
      "required": [
        "filters",
        "gain_db",
        "polarity",
        "delay_samples"
      ],
      "properties": {
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 12,
          "description": "Provisional output gain bound; human approval required."
        },
        "polarity": {
          "enum": [
            1,
            -1
          ]
        },
        "delay_samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095,
          "description": "Integer delay samples at fs_hz=48000; provisional maximum 4095 (85.3125 ms), human approval required."
        },
        "filters": {
          "$ref": "#/$defs/filterArray"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "id",
        "slot",
        "in",
        "chain",
        "protection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/inputMix"
          }
        },
        "chain": {
          "$ref": "#/$defs/outputChain"
        },
        "protection": {
          "$ref": "#/$defs/outputProtection"
        }
      },
      "additionalProperties": false
    },
    "outputProtection": {
      "type": "object",
      "required": [
        "peak_ceiling_dbfs",
        "excursion_weighting",
        "excursion_limit_dbfs",
        "rms_limit_dbfs",
        "rms_tau_ms",
        "release_ms"
      ],
      "properties": {
        "peak_ceiling_dbfs": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "excursion_weighting": {
          "$ref": "#/$defs/protectionFilterArray"
        },
        "excursion_limit_dbfs": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "rms_limit_dbfs": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "rms_tau_ms": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        },
        "release_ms": {
          "type": "number",
          "minimum": 20,
          "maximum": 5000
        }
      },
      "additionalProperties": false
    },
    "filter": {
      "type": "object",
      "required": [
        "type",
        "f_hz",
        "q",
        "gain_db"
      ],
      "properties": {
        "type": {
          "enum": [
            "lp1",
            "hp1",
            "lp2",
            "hp2",
            "peq",
            "lshelf",
            "hshelf",
            "ap1",
            "ap2",
            "notch"
          ]
        },
        "f_hz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 21600
        },
        "q": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20,
          "description": "Q for second-order filters and shelves; first-order lp1/hp1/ap1 require the neutral value 0.7071."
        },
        "gain_db": {
          "type": "number",
          "minimum": -24,
          "maximum": 24,
          "description": "Used by peq/lshelf/hshelf; all other filter types require 0."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "lp1",
                  "hp1",
                  "ap1"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "q": {
                "const": 0.7071
              },
              "gain_db": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "lp2",
                  "hp2",
                  "ap2",
                  "notch"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "gain_db": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "filterArray": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "protectionFilterArray": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/filter"
      }
    }
  }
}
