{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xover-esp32 chain-per-output configuration v1",
  "description": "Designer-owned DSP configuration only. Protected driver, amplifier, supply, and limiter thresholds are provisioned separately.",
  "type": "object",
  "required": ["v", "fs", "inputs", "outputs"],
  "properties": {
    "v": { "const": 1 },
    "fs": { "const": 48000 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["L", "R", "C", "LFE", "SL", "SR"] }
    },
    "pre": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/preChain" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/output" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "frequency": { "type": "number", "minimum": 10, "maximum": 21600 },
    "positiveQ": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
    "chain": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/block" }
    },
    "preChain": {
      "type": "object",
      "required": ["channel", "chain"],
      "properties": {
        "channel": { "enum": ["L", "R", "C", "LFE", "SL", "SR"] },
        "chain": { "$ref": "#/$defs/chain" }
      },
      "additionalProperties": false
    },
    "inputMix": {
      "type": "object",
      "required": ["channel", "weight"],
      "properties": {
        "channel": { "enum": ["L", "R", "C", "LFE", "SL", "SR"] },
        "weight": { "type": "number", "exclusiveMinimum": -4, "exclusiveMaximum": 4, "not": { "const": 0 } }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["id", "slot", "in", "chain"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 31, "pattern": "^[A-Za-z0-9_-]+$" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 31, "description": "Sanity bound only; the provisioned TDM slot count is authoritative." },
        "in": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/inputMix" } },
        "chain": { "$ref": "#/$defs/chain" },
        "protect": { "$ref": "#/$defs/protect" }
      },
      "additionalProperties": false
    },
    "protect": {
      "type": "object",
      "properties": {
        "attack_ms": { "type": "number", "exclusiveMinimum": 0 },
        "release_ms": { "type": "number", "exclusiveMinimum": 0 },
        "lookahead_ms": { "const": 0 }
      },
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["t", "k", "f_hz", "q"],
          "properties": {
            "t": { "const": "biquad" },
            "k": { "enum": ["lp", "hp", "peq", "notch", "allpass"] },
            "f_hz": { "$ref": "#/$defs/frequency" },
            "q": { "$ref": "#/$defs/positiveQ" },
            "db": { "type": "number", "minimum": -24, "maximum": 12 },
            "role": { "type": "string", "minLength": 1, "maxLength": 31 }
          },
          "allOf": [
            {
              "if": { "properties": { "k": { "const": "peq" } } },
              "then": { "required": ["db"] }
            },
            {
              "if": { "properties": { "k": { "enum": ["lp", "hp", "notch", "allpass"] } } },
              "then": { "not": { "required": ["db", "role"] } }
            },
            {
              "if": { "properties": { "k": { "enum": ["lp", "hp", "notch", "allpass"] } } },
              "then": { "not": { "anyOf": [{ "required": ["db"] }, { "required": ["role"] }] } }
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["t", "db"],
          "properties": {
            "t": { "const": "gain" },
            "db": { "type": "number", "minimum": -60, "maximum": 12 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["t", "us"],
          "properties": {
            "t": { "const": "delay" },
            "us": { "type": "number", "minimum": 0, "maximum": 20000 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["t", "invert"],
          "properties": {
            "t": { "const": "polarity" },
            "invert": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["t", "fs", "b", "a"],
          "properties": {
            "t": { "const": "sos" },
            "fs": { "const": 48000 },
            "b": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "a": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
