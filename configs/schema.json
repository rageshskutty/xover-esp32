{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xover-esp32 graph configuration",
  "type": "object",
  "required": [
    "version",
    "sample_rate_hz",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sample_rate_hz": {
      "const": 48000
    },
    "vars": {
      "type": "object",
      "description": "Numeric tunable parameters referenced as @name in node fields.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "limits": {
      "type": "object",
      "description": "Configuration-requested operating bounds. Firmware must additionally enforce immutable device protection limits stored in NVS; uploaded values must never weaken them.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 31
          },
          "type": {
            "enum": [
              "input",
              "output",
              "crossover",
              "peq",
              "shelf",
              "allpass",
              "notch",
              "biquad",
              "gain",
              "delay",
              "polarity",
              "mix"
            ]
          },
          "frequency_hz": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 10,
                "maximum": 21600
              },
              {
                "type": "string",
                "pattern": "^@[A-Za-z_][A-Za-z0-9_]*$"
              }
            ]
          },
          "family": {
            "enum": ["Butterworth", "Linkwitz-Riley", "Bessel"]
          },
          "mode": {
            "enum": [
              "lowpass",
              "highpass"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "channel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "gains": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "number"
            }
          },
          "db": {
            "type": "number"
          },
          "q": {
            "type": "number"
          },
          "shape": {
            "enum": ["low", "high"]
          },
          "invert": {
            "type": "boolean"
          },
          "b": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          },
          "a": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number"}
          },
          "sample_rate_hz": {
            "const": 48000
          },
          "delay_us": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "crossover"}}},
            "then": {"required": ["frequency_hz", "family", "mode", "order"], "propertyNames": {"enum": ["id", "type", "frequency_hz", "family", "mode", "order"]}}
          },
          {
            "if": {"properties": {"type": {"const": "peq"}}},
            "then": {"required": ["frequency_hz", "q", "db"], "properties": {"q": {"minimum": 0.1, "maximum": 20}, "db": {"minimum": -24, "maximum": 12}}, "propertyNames": {"enum": ["id", "type", "frequency_hz", "q", "db"]}}
          },
          {
            "if": {"properties": {"type": {"const": "shelf"}}},
            "then": {"required": ["frequency_hz", "db", "shape"], "properties": {"db": {"minimum": -24, "maximum": 12}}, "propertyNames": {"enum": ["id", "type", "frequency_hz", "db", "shape"]}}
          },
          {
            "if": {"properties": {"type": {"enum": ["allpass", "notch"]}}},
            "then": {"required": ["frequency_hz", "q"], "properties": {"q": {"minimum": 0.1, "maximum": 20}}, "propertyNames": {"enum": ["id", "type", "frequency_hz", "q"]}}
          },
          {
            "if": {"properties": {"type": {"const": "gain"}}},
            "then": {"required": ["db"], "properties": {"db": {"minimum": -60, "maximum": 12}}, "propertyNames": {"enum": ["id", "type", "db"]}}
          },
          {
            "if": {"properties": {"type": {"const": "polarity"}}},
            "then": {"required": ["invert"], "propertyNames": {"enum": ["id", "type", "invert"]}}
          },
          {
            "if": {"properties": {"type": {"const": "mix"}}},
            "then": {"required": ["gains"], "propertyNames": {"enum": ["id", "type", "gains"]}}
          },
          {
            "if": {"properties": {"type": {"const": "biquad"}}},
            "then": {"required": ["b", "a", "sample_rate_hz"], "propertyNames": {"enum": ["id", "type", "b", "a", "sample_rate_hz"]}}
          },
          {
            "if": {"properties": {"type": {"const": "input"}}},
            "then": {"required": ["channel"], "propertyNames": {"enum": ["id", "type", "channel"]}}
          },
          {
            "if": {"properties": {"type": {"const": "output"}}},
            "then": {"required": ["slot"], "propertyNames": {"enum": ["id", "type", "slot"]}}
          },
          {
            "if": {"properties": {"type": {"const": "delay"}}},
            "then": {"required": ["delay_us"], "propertyNames": {"enum": ["id", "type", "delay_us"]}}
          },
          {
            "if": {"properties": {"type": {"const": "crossover"}, "family": {"const": "Linkwitz-Riley"}}},
            "then": {"properties": {"order": {"enum": [2, 4, 6, 8]}}}
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "additionalProperties": false
}
