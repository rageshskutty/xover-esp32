{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xover-esp32 chain-v1 configuration",
  "description": "Closed device configuration. Per-output abstract protection is mandatory. Driver T/S, driver curves, amplifier/PSU model data, volts, and watts are designer-side only and are forbidden in device JSON.",
  "type": "object",
  "required": [
    "v",
    "fs",
    "inputs",
    "outputs"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "fs": {
      "const": 48000
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "L",
          "R",
          "C",
          "LFE",
          "SL",
          "SR"
        ]
      }
    },
    "pre": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/preChain"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/output"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "frequency": {
      "type": "number",
      "minimum": 10,
      "maximum": 21600
    },
    "positiveQ": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 20
    },
    "chain": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "preChain": {
      "type": "object",
      "required": [
        "channel",
        "chain"
      ],
      "properties": {
        "channel": {
          "enum": [
            "L",
            "R",
            "C",
            "LFE",
            "SL",
            "SR"
          ]
        },
        "chain": {
          "$ref": "#/$defs/chain"
        }
      },
      "additionalProperties": false
    },
    "inputMix": {
      "type": "object",
      "required": [
        "channel",
        "weight"
      ],
      "properties": {
        "channel": {
          "enum": [
            "L",
            "R",
            "C",
            "LFE",
            "SL",
            "SR"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": -4,
          "maximum": 4,
          "not": {
            "const": 0
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "id",
        "slot",
        "in",
        "chain",
        "protection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "description": "Sanity bound only; the provisioned TDM slot count is authoritative."
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/inputMix"
          }
        },
        "chain": {
          "$ref": "#/$defs/chain"
        },
        "protection": {
          "$ref": "#/$defs/outputProtection"
        }
      },
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "t",
            "k",
            "f_hz",
            "q"
          ],
          "properties": {
            "t": {
              "const": "biquad"
            },
            "k": {
              "enum": [
                "lp",
                "hp",
                "peq",
                "notch",
                "allpass"
              ]
            },
            "f_hz": {
              "$ref": "#/$defs/frequency"
            },
            "q": {
              "$ref": "#/$defs/positiveQ"
            },
            "db": {
              "type": "number",
              "minimum": -24,
              "maximum": 12
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 31
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "k": {
                    "const": "peq"
                  }
                }
              },
              "then": {
                "required": [
                  "db"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "k": {
                    "enum": [
                      "lp",
                      "hp",
                      "notch",
                      "allpass"
                    ]
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "db",
                    "role"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "k": {
                    "enum": [
                      "lp",
                      "hp",
                      "notch",
                      "allpass"
                    ]
                  }
                }
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "db"
                      ]
                    },
                    {
                      "required": [
                        "role"
                      ]
                    }
                  ]
                }
              }
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "t",
            "db"
          ],
          "properties": {
            "t": {
              "const": "gain"
            },
            "db": {
              "type": "number",
              "minimum": -60,
              "maximum": 12
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "t",
            "us"
          ],
          "properties": {
            "t": {
              "const": "delay"
            },
            "us": {
              "type": "number",
              "minimum": 0,
              "maximum": 20000
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "t",
            "invert"
          ],
          "properties": {
            "t": {
              "const": "polarity"
            },
            "invert": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "t",
            "fs",
            "b",
            "a"
          ],
          "properties": {
            "t": {
              "const": "sos"
            },
            "fs": {
              "const": 48000
            },
            "b": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "a": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "excursionFilter": {
      "type": "object",
      "required": [
        "type",
        "f_hz",
        "q"
      ],
      "properties": {
        "type": {
          "enum": [
            "hp",
            "lp",
            "peq",
            "lshelf",
            "hshelf"
          ]
        },
        "f_hz": {
          "$ref": "#/$defs/frequency"
        },
        "q": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "gain_db": {
          "type": "number",
          "minimum": -24,
          "maximum": 12
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "peq",
                  "lshelf",
                  "hshelf"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "gain_db"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "hp",
                  "lp"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "gain_db"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "outputProtection": {
      "type": "object",
      "required": [
        "peak_ceiling_dbfs",
        "excursion_weighting",
        "excursion_limit_dbfs",
        "rms_limit_dbfs",
        "rms_tau_ms",
        "release_ms"
      ],
      "properties": {
        "peak_ceiling_dbfs": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "excursion_weighting": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/excursionFilter"
          }
        },
        "excursion_limit_dbfs": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "rms_limit_dbfs": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "rms_tau_ms": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        },
        "release_ms": {
          "type": "number",
          "minimum": 20,
          "maximum": 5000
        }
      },
      "additionalProperties": false
    }
  }
}
