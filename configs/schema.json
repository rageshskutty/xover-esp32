{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xover-esp32 chain-v1 configuration",
  "description": "Closed device configuration. All filters are imported normalized SOS coefficients; firmware executes but never designs filters. Per-output abstract protection is mandatory. Driver T/S, driver curves, amplifier/PSU model data, volts, and watts are designer-side only.",
  "type": "object",
  "required": [
    "v",
    "fs_hz",
    "inputs",
    "outputs"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "fs_hz": {
      "const": 48000,
      "description": "The sole v1 sample rate; all SOS sections and firmware execute at this rate."
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "L",
          "R",
          "C",
          "LFE",
          "SL",
          "SR"
        ]
      }
    },
    "pre": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/preChain"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/output"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sosSection": {
      "type": "object",
      "required": [
        "b0",
        "b1",
        "b2",
        "a1",
        "a2"
      ],
      "properties": {
        "b0": {
          "type": "number",
          "minimum": -16,
          "maximum": 16,
          "description": "Provisional absolute coefficient bound; human approval required."
        },
        "b1": {
          "type": "number",
          "minimum": -16,
          "maximum": 16,
          "description": "Provisional absolute coefficient bound; human approval required."
        },
        "b2": {
          "type": "number",
          "minimum": -16,
          "maximum": 16,
          "description": "Provisional absolute coefficient bound; human approval required."
        },
        "a1": {
          "type": "number",
          "minimum": -2,
          "maximum": 2,
          "description": "Provisional bound; semantic stability test also applies."
        },
        "a2": {
          "type": "number",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 1,
          "description": "Strictly between -1 and +1; semantic stability test also applies."
        }
      },
      "additionalProperties": false,
      "description": "H(z)=(b0+b1 z^-1+b2 z^-2)/(1+a1 z^-1+a2 z^-2), a0=1. Semantic validation also enforces abs(a1) < 1+a2."
    },
    "sosArray": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/sosSection"
      }
    },
    "preChain": {
      "type": "object",
      "required": [
        "channel",
        "sos"
      ],
      "properties": {
        "channel": {
          "enum": [
            "L",
            "R",
            "C",
            "LFE",
            "SL",
            "SR"
          ]
        },
        "sos": {
          "$ref": "#/$defs/sosArray"
        }
      },
      "additionalProperties": false
    },
    "inputMix": {
      "type": "object",
      "required": [
        "channel",
        "weight"
      ],
      "properties": {
        "channel": {
          "enum": [
            "L",
            "R",
            "C",
            "LFE",
            "SL",
            "SR"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": -4,
          "maximum": 4,
          "not": {
            "const": 0
          }
        }
      },
      "additionalProperties": false
    },
    "outputChain": {
      "type": "object",
      "required": [
        "sos",
        "gain_db",
        "polarity",
        "delay_samples"
      ],
      "properties": {
        "sos": {
          "$ref": "#/$defs/sosArray"
        },
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 12,
          "description": "Provisional output gain bound; human approval required."
        },
        "polarity": {
          "enum": [
            1,
            -1
          ]
        },
        "delay_samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095,
          "description": "Integer delay samples at fs_hz=48000; provisional maximum 4095 (85.3125 ms), human approval required."
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "id",
        "slot",
        "in",
        "chain",
        "protection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/inputMix"
          }
        },
        "chain": {
          "$ref": "#/$defs/outputChain"
        },
        "protection": {
          "$ref": "#/$defs/outputProtection"
        }
      },
      "additionalProperties": false
    },
    "outputProtection": {
      "type": "object",
      "required": [
        "peak_ceiling_dbfs",
        "excursion_weighting",
        "excursion_limit_dbfs",
        "rms_limit_dbfs",
        "rms_tau_ms",
        "release_ms"
      ],
      "properties": {
        "peak_ceiling_dbfs": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "excursion_weighting": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/sosSection"
          }
        },
        "excursion_limit_dbfs": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "rms_limit_dbfs": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "rms_tau_ms": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        },
        "release_ms": {
          "type": "number",
          "minimum": 20,
          "maximum": 5000
        }
      },
      "additionalProperties": false
    }
  }
}
