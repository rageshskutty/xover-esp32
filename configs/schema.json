{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xover-esp32 parametric crossover configuration v1",
  "description": "Designer-authored parametric filter stacks; firmware expands each filter once during configuration load.",
  "type": "object",
  "required": [
    "v",
    "fs",
    "inputs",
    "outputs"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "fs": {
      "const": 48000
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "L",
          "R",
          "C",
          "LFE",
          "SL",
          "SR"
        ]
      }
    },
    "pre": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/pre"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "protection": {
      "$ref": "#/$defs/protection"
    },
    "links": {
      "type": "array",
      "maxItems": 4,
      "description": "Groups of output ids that share gain reduction (maximum reduction across the group).",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "filter": {
      "type": "object",
      "required": [
        "type",
        "f_hz",
        "q",
        "gain_db"
      ],
      "properties": {
        "type": {
          "enum": [
            "lp1",
            "hp1",
            "lp2",
            "hp2",
            "peq",
            "lshelf",
            "hshelf",
            "ap1",
            "ap2",
            "notch"
          ]
        },
        "f_hz": {
          "type": "number",
          "minimum": 20,
          "exclusiveMaximum": 21600
        },
        "q": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "gain_db": {
          "type": "number",
          "minimum": -24,
          "maximum": 24
        }
      },
      "additionalProperties": false
    },
    "filters": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "pre": {
      "type": "object",
      "required": [
        "channel",
        "filters"
      ],
      "properties": {
        "channel": {
          "enum": [
            "L",
            "R",
            "C",
            "LFE",
            "SL",
            "SR"
          ]
        },
        "filters": {
          "$ref": "#/$defs/filters"
        }
      },
      "additionalProperties": false
    },
    "mix": {
      "type": "object",
      "required": [
        "channel",
        "weight"
      ],
      "properties": {
        "channel": {
          "enum": [
            "L",
            "R",
            "C",
            "LFE",
            "SL",
            "SR"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": -4,
          "maximum": 4,
          "not": {
            "const": 0
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "id",
        "slot",
        "in",
        "filters",
        "gain_db",
        "polarity",
        "delay_samples"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/mix"
          }
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 12
        },
        "polarity": {
          "enum": [
            -1,
            1
          ]
        },
        "delay_samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 960
        }
      },
      "additionalProperties": false
    },
    "weighting": {
      "type": "object",
      "required": [
        "filters"
      ],
      "properties": {
        "filters": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/filter"
          }
        }
      },
      "additionalProperties": false
    },
    "protectedOutput": {
      "type": "object",
      "required": [
        "id",
        "weighting",
        "peak_threshold_dbfs",
        "hold_ms",
        "thermal",
        "release_ms",
        "ceiling_dbfs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "weighting": {
          "$ref": "#/$defs/weighting"
        },
        "peak_threshold_dbfs": {
          "type": "number",
          "minimum": -120,
          "maximum": 0
        },
        "release_ms": {
          "type": "number",
          "minimum": 20,
          "maximum": 5000
        },
        "ceiling_dbfs": {
          "type": "number",
          "minimum": -120,
          "maximum": 0
        },
        "hold_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "thermal": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/thermalStage"
          }
        }
      },
      "additionalProperties": false
    },
    "protection": {
      "type": "object",
      "required": [
        "outputs"
      ],
      "properties": {
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/protectedOutput"
          }
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "thermalStage": {
      "type": "object",
      "description": "Unweighted RMS detector stage. rms_threshold_dbfs is the RMS of normalised samples (full scale = 1.0), so a full-scale sine reads -3.01 dBFS.",
      "required": [
        "rms_threshold_dbfs",
        "rms_tau_ms"
      ],
      "properties": {
        "rms_threshold_dbfs": {
          "type": "number",
          "minimum": -120,
          "maximum": 0
        },
        "rms_tau_ms": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        }
      },
      "additionalProperties": false
    }
  }
}
